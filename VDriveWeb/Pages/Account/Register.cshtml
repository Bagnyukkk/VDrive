@page
@model VDriveWeb.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Реєстрація у VDrive";
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <h2 class="text-center mb-4">Реєстрація</h2>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="RegisterInput.FullName"></label>
                <input asp-for="RegisterInput.FullName" class="form-control" />
                <span asp-validation-for="RegisterInput.FullName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="RegisterInput.Username"></label>
                <input asp-for="RegisterInput.Username" class="form-control" />
                <span asp-validation-for="RegisterInput.Username" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="RegisterInput.Password"></label>
                <input asp-for="RegisterInput.Password" class="form-control" />
                <span asp-validation-for="RegisterInput.Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success w-100">Зареєструватися</button>
        </form>

        <p class="mt-3 text-center">
            Вже маєте обліковий запис? <a asp-page="/Account/Login">Увійти</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}